# Prisma <-> Supabase Postgres
# Lấy tại: Supabase Dashboard > Project Settings > Database > Connection string

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# Supabase client (nếu dùng @supabase/supabase-js ở phía client/browser)
# Lấy tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Chỉ dùng ở server (route handlers/server actions), KHÔNG bao giờ lộ ra client
SUPABASE_SERVICE_ROLE_KEY=""


