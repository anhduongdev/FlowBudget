# Postgres chạy local qua Docker (docker compose up -d) — không dùng Supabase/Vercel
# Toàn bộ bảng nằm trong schema "app" (không phải "public"), bắt buộc có ?schema=app

# Role giới hạn quyền — app runtime dùng cái này để Row Level Security có tác dụng thật
# (role superuser/owner sẽ bypass RLS mặc định)
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/expense_management?schema=app"

# Role chủ sở hữu — chỉ dùng cho `prisma migrate`/`prisma db pull`, không dùng ở app runtime
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/expense_management?schema=app"
