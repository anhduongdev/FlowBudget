generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    String?  @db.Uuid
  table_name String
  record_id  String   @db.Uuid
  action     String
  old_data   Json?
  new_data   Json?
  changed_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([table_name, record_id, changed_at(sort: Desc)], map: "idx_audit_record")
  @@index([user_id, changed_at(sort: Desc)], map: "idx_audit_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model categories {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String                    @db.Uuid
  parent_id               String?                   @db.Uuid
  kind                    category_kind
  name                    String
  icon                    String?
  color                   String?
  is_essential            Boolean                   @default(false)
  is_system               Boolean                   @default(false)
  sort_order              Int                       @default(0)
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at              DateTime?                 @db.Timestamptz(6)
  categories              categories?               @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories        categories[]              @relation("categoriesTocategories")
  users                   users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cycle_fixed_expenses    cycle_fixed_expenses[]
  fixed_expense_templates fixed_expense_templates[]
  planned_incomes         planned_incomes[]
  transactions            transactions[]

  @@index([parent_id], map: "idx_categories_parent", where: raw("(parent_id IS NOT NULL)"))
  @@index([user_id, kind], map: "idx_categories_user_kind", where: raw("(deleted_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cycle_fixed_expenses {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id                String                   @db.Uuid
  template_id             String?                  @db.Uuid
  category_id             String?                  @db.Uuid
  wallet_id               String?                  @db.Uuid
  name                    String
  planned_amount          Decimal                  @db.Decimal(15, 2)
  due_date                DateTime?                @db.Date
  actual_amount           Decimal                  @default(0) @db.Decimal(15, 2)
  paid_date               DateTime?                @db.Date
  status                  settlement_status        @default(PENDING)
  note                    String?
  sort_order              Int                      @default(0)
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                 @default(now()) @db.Timestamptz(6)
  categories              categories?              @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  salary_cycles           salary_cycles            @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fixed_expense_templates fixed_expense_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction)
  wallets                 wallets?                 @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)
  transactions            transactions[]

  @@unique([cycle_id, template_id], map: "uq_cfe_tpl_per_cycle", where: raw("(template_id IS NOT NULL)"))
  @@index([cycle_id, status], map: "idx_cfe_cycle")
  @@index([cycle_id, due_date], map: "idx_cfe_cycle_due")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model daily_plans {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id       String        @db.Uuid
  plan_date      DateTime      @db.Date
  planned_amount Decimal       @default(0) @db.Decimal(15, 2)
  source         plan_source   @default(TEMPLATE)
  note           String?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  salary_cycles  salary_cycles @relation(fields: [cycle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cycle_id, plan_date], map: "uq_dp_cycle_date")
  @@index([cycle_id, plan_date], map: "idx_dp_cycle_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fixed_expense_templates {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                 @db.Uuid
  category_id          String?                @db.Uuid
  wallet_id            String?                @db.Uuid
  name                 String
  default_amount       Decimal                @db.Decimal(15, 2)
  recurrence           recurrence_unit        @default(MONTHLY)
  due_day              Int?                   @db.SmallInt
  auto_add             Boolean                @default(true)
  is_active            Boolean                @default(true)
  sort_order           Int                    @default(0)
  note                 String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  cycle_fixed_expenses cycle_fixed_expenses[]
  categories           categories?            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets              wallets?               @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_fet_user", where: raw("((deleted_at IS NULL) AND is_active)"))
}

