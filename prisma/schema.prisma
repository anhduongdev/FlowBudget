  name                 String?
  start_date           DateTime               @db.Date
  end_date             DateTime               @db.Date
  salary_amount        Decimal                @default(0) @db.Decimal(15, 2)
  savings_goal         Decimal                @default(0) @db.Decimal(15, 2)
  opening_balance      Decimal                @default(0) @db.Decimal(15, 2)
  closing_balance      Decimal?               @db.Decimal(15, 2)
  status               cycle_status           @default(ACTIVE)
  note                 String?
  closed_at            DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  cycle_fixed_expenses cycle_fixed_expenses[]
  daily_plans          daily_plans[]
  planned_incomes      planned_incomes[]
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spending_templates   spending_templates?
