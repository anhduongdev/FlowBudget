enum category_kind {
  INCOME
  EXPENSE
}

enum cycle_status {
  DRAFT
  ACTIVE
  CLOSED
}

enum plan_source {
  TEMPLATE
  MANUAL
}

enum recurrence_unit {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum settlement_status {
  PENDING
  PARTIAL
  DONE
  SKIPPED
}

enum spending_template_mode {
  FLAT
  BY_WEEKDAY
}

enum txn_direction {
  INCOME
  EXPENSE
}

enum wallet_type {
  CASH
  BANK
  EWALLET
  CREDIT_CARD
  SAVINGS
  INVESTMENT
  OTHER
}
