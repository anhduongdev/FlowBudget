# MySQL chạy local qua Docker (docker compose up -d)
DATABASE_URL="mysql://app_user:app_password@localhost:3307/expense_management"

# Khoá ký cookie session (HMAC-SHA256) — tối thiểu 32 ký tự.
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="__generate_your_own_random_32+_char_secret__"
